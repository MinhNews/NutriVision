@startuml NutriVision_UseCase_Overview
' ============================================================
'  NUTRIVISION - SƠ ĐỒ USE CASE TỔNG QUÁT (Tuần 1)
'  Render: java -jar plantuml.jar -tpng -charset UTF-8 02_UseCase_Diagram.puml
'  Hoặc dán vào https://www.plantuml.com/plantuml/uml/
' ============================================================
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam nodesep 30
skinparam ranksep 45
skinparam usecase {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontSize 13
}
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

actor "Khách\n(chưa đăng nhập)" as Guest
actor "Người dùng\n(đã đăng nhập)" as User
actor "Quản trị viên\n(nội bộ nhóm)" as Admin

rectangle "HỆ THỐNG NUTRIVISION" {

  package "1. Tài khoản" {
    usecase "UC01. Đăng ký" as UC01
    usecase "UC02. Đăng nhập" as UC02
    usecase "UC03. Đăng xuất" as UC03
    usecase "UC04. Quên mật khẩu" as UC04
    usecase "UC05. Hồ sơ & mục tiêu" as UC05
  }

  package "2. Phân tích bữa ăn" {
    usecase "UC06. Chụp / chọn ảnh" as UC06
    usecase "UC07. Nhận diện món" as UC07
    usecase "UC08. Xác nhận / sửa món" as UC08
    usecase "UC09. Chọn khẩu phần" as UC09
    usecase "UC10. Chi tiết dinh dưỡng" as UC10
  }

  package "3. Nhật ký & theo dõi" {
    usecase "UC11. Ghi nhật ký" as UC11
    usecase "UC12. Sửa / xóa mục" as UC12
    usecase "UC13. Dashboard ngày" as UC13
    usecase "UC14. Lịch sử & thống kê" as UC14
  }

  package "4. Tra cứu & tiện ích" {
    usecase "UC15. Tìm kiếm món" as UC15
    usecase "UC16. Nhắc nhở bữa ăn" as UC16
    usecase "UC17. Cài đặt" as UC17
    usecase "UC18. Gợi ý thực đơn" as UC18
    usecase "UC19. Quét mã vạch" as UC19
  }

  package "5. Quản trị dữ liệu" {
    usecase "UC20. Quản lý món ăn" as UC20
    usecase "UC21. Cập nhật dữ liệu" as UC21
  }
}

Guest --> UC01
Guest --> UC02
Guest --> UC04

User --> UC03
User --> UC05
User --> UC06
User --> UC08
User --> UC09
User --> UC10
User --> UC11
User --> UC12
User --> UC13
User --> UC14
User --> UC15
User --> UC16
User --> UC17
User --> UC18
User --> UC19

Admin --> UC20
Admin --> UC21

@enduml


@startuml NutriVision_UseCase_AnalyzeMeal_Detail
' ============================================================
'  SƠ ĐỒ CHI TIẾT: UC "Phân tích bữa ăn từ ảnh" (UC06 -> UC11)
' ============================================================
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam nodesep 25
skinparam ranksep 35
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontSize 12
}
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

actor "Người dùng" as U
actor "AI Engine\n(TFLite)" as AI <<system>>
actor "Room DB\n(SQLite)" as DB <<system>>

rectangle "Phân tích bữa ăn từ ảnh" {
  usecase "UC06\nChụp / chọn ảnh" as A
  usecase "Tiền xử lý ảnh\n224×224" as B
  usecase "UC07\nNhận diện top-3" as C
  usecase "UC08\nXác nhận / sửa món" as D
  usecase "UC15\nTìm kiếm thủ công" as D2
  usecase "UC09\nChọn khẩu phần" as E
  usecase "Tính dinh dưỡng\ntheo gram" as F
  usecase "UC10\nXem chi tiết" as G
  usecase "UC11\nLưu nhật ký" as H
  usecase "UC13\nCập nhật Dashboard" as I
}

U --> A
A ..> B : <<include>>
B ..> C : <<include>>
C --> AI
C ..> D : <<include>>
D <.. D2 : <<extend>>
D ..> E : <<include>>
E ..> F : <<include>>
F ..> G : <<include>>
G ..> H : <<include>>
H --> DB
H ..> I : <<include>>

@enduml
