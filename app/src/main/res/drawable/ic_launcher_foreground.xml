<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground của adaptive icon: lá trắng + gân xanh + cuống + tia sáng.
  Toàn bộ nằm trong vùng an toàn 72dp ở giữa (18..90) để không bị mặt nạ cắt mất.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thu nhỏ tỉ lệ 0.72 quanh tâm (54, 54) để icon thoáng đãng, thấy toàn cảnh chiếc lá -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Quầng xanh nhạt sau lá, tạo chiều sâu -->
        <path
            android:fillColor="#24A3E635"
            android:pathData="M88,61 A27,27 0 1,1 34,61 A27,27 0 1,1 88,61 Z" />

        <!-- Lá chính -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M36,76 C33,52 47,35 73,31 C75,57 63,74 36,76 Z" />

        <!-- Gân lá -->
        <path
            android:fillColor="#00000000"
            android:pathData="M37,75 C44,66 54,54 66,41"
            android:strokeColor="#E60E9D6B"
            android:strokeWidth="3"
            android:strokeLineCap="round" />

        <!-- Cuống -->
        <path
            android:fillColor="#00000000"
            android:pathData="M36,76 C34,80 32,83 29,86"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />

        <!-- Tia sáng nhỏ -->
        <path
            android:fillColor="#D9FFFFFF"
            android:pathData="M79,23.4 C79.6,26.2 81.4,28 84.2,28.6 C81.4,29.2 79.6,31 79,33.8 C78.4,31 76.6,29.2 73.8,28.6 C76.6,28 78.4,26.2 79,23.4 Z" />
    </group>
</vector>
